{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Herramientas",
  "version": "0.1.0",
  "identifier": "com.arksol.herramientas",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Herramientas", "width": 1280, "height": 820, "minWidth": 900, "minHeight": 620 }],
    "security": { "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:3030 http://127.0.0.1:11434 https://127.0.0.1:27124" }
  },
  "bundle": { "active": true, "targets": "all", "icon": [] }
}
